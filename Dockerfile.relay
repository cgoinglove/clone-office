# The relay alone, for a server: `docker compose up -d` (docker-compose.yml) runs it with Postgres.
# It needs only its own files and a few packages (Postgres, PGlite, Better Auth for people's
# accounts); Node runs the TypeScript as it is.
FROM node:22-alpine
WORKDIR /relay
COPY package.json /tmp/app-package.json
RUN node -e "const d = require('/tmp/app-package.json').dependencies; require('fs').writeFileSync('package.json', JSON.stringify({ private: true, type: 'module', dependencies: Object.fromEntries(['pg', '@electric-sql/pglite', 'better-auth', 'kysely'].map((n) => [n, d[n]])) }))" \
  && npm install --omit=dev --no-audit --no-fund \
  && rm /tmp/app-package.json \
  && chown -R node:node /relay
# The relay's own folder as it is in the repository (its tests left out by .dockerignore), and the
# shared files it imports, at the same places, so its relative imports hold: the sealing, and for
# the office drawing on its pages (room-page.ts) the room's own files, how the app reads the office
# for it, and the app's words.
COPY --chown=node:node features/relay/ ./features/relay/
COPY --chown=node:node lib/seal.ts ./lib/seal.ts
COPY --chown=node:node features/office/room/*.mjs features/office/room/*.css ./features/office/room/
COPY --chown=node:node features/minime/office/room-data.ts ./features/minime/office/room-data.ts
COPY --chown=node:node messages/ ./messages/
# The sealing key's folder, a volume of its own in the compose file: kept apart from the database.
RUN mkdir -p /relay/keys && chown node:node /relay/keys
ENV RELAY_KEY_DIR=/relay/keys
ENV NODE_ENV=production
USER node
EXPOSE 3200
# DATABASE_URL picks the Postgres server; without it the office is kept in /relay/relay-data.
# The key that seals team keys and sign-in secrets is made once in /relay/keys, unless
# RELAY_ENCRYPTION_KEY gives one (features/relay/team-ai.ts).
CMD ["node", "features/relay/server.ts", "--host", "0.0.0.0"]
